# Postgres connection string. UK/EU region in production (Neon/Supabase).
DATABASE_URL="postgresql://user:password@localhost:5432/bncl_dev?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-real-32-byte-random-secret"

# Magic link email provider (NextAuth Email provider, SMTP)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="no-reply@bncl.example"

# S3-compatible object storage (UK region assumed)
S3_ENDPOINT=""
S3_REGION="eu-west-2"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Stripe (Phase 7)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PAID_TIER=""
